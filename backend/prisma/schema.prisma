generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RESEARCHER
  GOVERNMENT
  PUBLIC
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IngestionStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model User {
  id            String    @id @default(uuid())

  name          String
  email         String    @unique
  passwordHash  String

  role          UserRole  @default(PUBLIC)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Station {

  id                  String   @id @default(uuid())

  stationName         String
  agency              String

  state               String
  stateLGDCode        String?

  district            String
  districtLGDCode     String?

  tehsil              String?
  block               String?
  village             String?

  river               String?
  basin               String?

  tributary           String?
  subTributary        String?
  subSubTributary     String?
  localRiver          String?

  latitude            Float
  longitude           Float

  rlMsl               Float?

  isActive            Boolean @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  readings            GroundwaterReading[]
  forecasts           Forecast[]
  rechargeResults     RechargeResult[]
  alerts              Alert[]

  @@unique([stationName, agency, latitude, longitude])
}

model GroundwaterReading {

  id                  String   @id @default(uuid())

  stationId           String
  station             Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  timestamp           DateTime

  rawWaterLevel       Float

  cleanedWaterLevel   Float?

  isAnomaly           Boolean  @default(false)

  isImputed           Boolean  @default(false)

  dataSource          String   @default("NWDP")

  createdAt           DateTime @default(now())

  @@unique([stationId, timestamp])

  @@index([stationId])
  @@index([timestamp])
  @@index([stationId, timestamp])
}

model Forecast {

  id                  String   @id @default(uuid())

  stationId           String
  station             Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  forecastTime        DateTime

  predictedLevel      Float

  confidence          Float?

  modelName           String

  generatedAt         DateTime @default(now())

  @@index([stationId])

  @@unique([stationId, forecastTime, modelName])
}

model RechargeResult {

  id                  String   @id @default(uuid())

  stationId           String
  station             Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  periodStart         DateTime
  periodEnd           DateTime

  recharge            Float

  deltaWaterLevel     Float

  specificYield       Float

  createdAt           DateTime @default(now())

  @@index([stationId])
}

model Alert {

  id                  String   @id @default(uuid())

  stationId           String
  station             Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  title               String

  message             String

  severity            AlertSeverity

  isResolved          Boolean @default(false)

  createdAt           DateTime @default(now())

  resolvedAt          DateTime?
}

model IngestionLog {

  id                  String   @id @default(uuid())

  startedAt           DateTime

  completedAt         DateTime?

  recordsFetched      Int

  recordsInserted     Int

  status              IngestionStatus

  message             String?
}